# Copy to .env (git-ignored). Used by docker compose (interpolation) and by the API on the host.
# Infrastructure only. Business config (payment/AI provider, lock TTL, etc.) lives in platform_settings.

# --- Runtime mode -----------------------------------------------------------
# development | production. docker-compose.yml defaults to production when unset.
# Production: mock operator, mock payments and the demo seed are off, secrets below are enforced at boot.
NODE_ENV=development
# false = seed keeps the safe production-like settings (demo.incidentInjection off, etc.)
DEMO_MODE=true
# true = api container runs the demo seed after db push (known password Demo@12345). Never in production.
SEED_DEMO=false
# false on extra API replicas so only one instance runs db push / db:sql
RUN_DB_SETUP=true

# --- Database ---------------------------------------------------------------
# Host-run API/tests. Compose builds its own DATABASE_URL (host "postgres") from the POSTGRES_* values.
DATABASE_URL=postgresql://wnmp:wnmp@localhost:5432/wnmp?schema=public
# Production: set a strong password (URL-safe characters only, it is embedded in DATABASE_URL).
POSTGRES_USER=wnmp
POSTGRES_PASSWORD=wnmp
POSTGRES_DB=wnmp
POSTGRES_PORT=5432

# --- URLs / ports -----------------------------------------------------------
API_PORT=4000
WEB_PORT=3000
# Comma-separated browser origins allowed by CORS; also used for payment return URLs.
WEB_ORIGIN=http://localhost:3000
# Browser-reachable API origin, baked into the web bundle at build time (compose build arg).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Origin the seed stores for the simulated operator APIs (the API calls itself, so localhost is correct in demo).
PUBLIC_API_URL=http://localhost:4000

# --- Secrets (MUST be set in production) ------------------------------------
# NODE_ENV=production: the API refuses to boot unless both are random and >= 32 chars.
#   openssl rand -base64 48
# Inject them from a secret manager / CI secrets; never commit real values.
JWT_ACCESS_SECRET=change-me
CREDENTIALS_ENCRYPTION_KEY=change-me
# Unused by the code today (no refresh tokens yet, see S-12); keep for when refresh is added.
JWT_REFRESH_SECRET=change-me

# --- Proxy / rate limiting --------------------------------------------------
# Number of reverse proxies in front of the API (e.g. 1); required for correct req.ip behind nginx/ALB.
TRUST_PROXY_HOPS=
# Per-IP requests per minute. Unset = 1200 in production, disabled otherwise. Heavy = auth/explorer/ai/insights.
RATE_LIMIT_PER_MIN=
RATE_LIMIT_HEAVY_PER_MIN=

# --- Demo-only switches: leave unset/false in production --------------------
#   ALLOW_PRIVATE_OPERATOR_URLS=true  allow operator URLs on private/loopback addresses (SSRF guard off)
#   ENABLE_MOCK_OPERATOR=true         mount the simulated operator + incident-injection endpoints
#   ALLOW_MOCK_PAYMENTS=true          let buyers self-complete mock payments
#   ALLOW_DEMO_SEED=true              allow the seed script to run when NODE_ENV=production
ALLOW_PRIVATE_OPERATOR_URLS=
ENABLE_MOCK_OPERATOR=
ALLOW_MOCK_PAYMENTS=
ALLOW_DEMO_SEED=

# --- Provider secrets (selected provider is chosen in platform_settings) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=
XENDIT_SECRET_KEY=
STRIPE_SECRET_KEY=
