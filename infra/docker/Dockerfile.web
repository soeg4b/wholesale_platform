# Build context: repository root.
#   docker build -f infra/docker/Dockerfile.web --build-arg NEXT_PUBLIC_API_URL=https://api.example.com -t wnmp-web .
# NEXT_PUBLIC_API_URL is inlined into the client bundle at build time, so it must be the browser-reachable API origin.
FROM node:22-bookworm-slim AS base
WORKDIR /app

FROM base AS build
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci --workspace apps/web
COPY apps/web apps/web
RUN npm run build --workspace apps/web

FROM base AS runtime
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci --omit=dev --workspace apps/web && npm cache clean --force
COPY --from=build --chown=node:node /app/apps/web ./apps/web

USER node
WORKDIR /app/apps/web
EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"]

CMD ["npx", "--no-install", "next", "start", "-H", "0.0.0.0", "-p", "3000"]
