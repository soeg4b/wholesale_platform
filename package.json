{
  "name": "wholesale-network-marketplace-platform",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "build:web": "npm run build --workspace apps/web",
    "build:api": "npm run build --workspace apps/api",
    "lint": "npm run lint --workspace apps/web && npm run lint --workspace apps/api",
    "format": "prettier --write .",
    "prisma:generate": "npm run prisma:generate --workspace apps/api",
    "prisma:validate": "npm run prisma:validate --workspace apps/api",
    "db:up": "docker compose up -d postgres",
    "test": "node --test tests/"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
